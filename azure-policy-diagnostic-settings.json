  {
    "name": "deploy-diag-webapp-to-loganalytics",
    "properties": {
      "displayName": "Deploy diagnostic settings for Web Apps to a Log Analytics workspace",
      "description": "Deploys diagnostic settings (all logs + all metrics) for App Service web apps (excludes function apps) to a Log Analytics workspace.",
      "policyType": "Custom",
      "mode": "Indexed",
      "metadata": { "category": "Monitoring", "version": "1.0.0" },
      "parameters": {
        "effect": { "type": "String", "metadata": { "displayName": "Effect" }, "allowedValues": ["DeployIfNotExists", "AuditIfNotExists", "Disabled"], "defaultValue": "DeployIfNotExists" },
